# ============================================================================
# SecondLife environment template. Copy to .env.local (development) or set in
# your host's dashboard (production). NEVER commit real values.
#
# Rule: VITE_* variables are compiled INTO the browser bundle. Only put public
# values there. SUPABASE_SERVICE_ROLE_KEY and ANTHROPIC_API_KEY must be server-only.
# ============================================================================

# --- Browser (public) -------------------------------------------------------
# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Supabase "anon" public key. Safe in the browser because RLS protects the data.
VITE_SUPABASE_ANON_KEY=
# Leave empty when the API is served from the same origin (default).
VITE_API_BASE_URL=

# --- Server only (never prefix with VITE_) ----------------------------------
# Same project URL and anon key as above. The server reads these names.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. Used only for recommendation writes, status
# changes by verified admins, and the admin list. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without it, recommendations are labelled rule-based.
ANTHROPIC_API_KEY=
# Model used for AI recommendations. Override if your account uses another model.
ANTHROPIC_MODEL=claude-haiku-5-5

# API port for `npm run api` and the dev proxy.
API_PORT=8787
# Production only: directory containing the built SPA (`dist`). Enables `npm start`.
SERVE_DIST_DIR=
